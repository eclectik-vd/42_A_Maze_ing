# ------------------------------------------------------
# Environnement Python
# ------------------------------------------------------

# Virtual environment
.venv/



# ------------------------------------------------------
# Outils et Caches
# ------------------------------------------------------

# Python bytecode automatically generated at runtime
__pycache__/
*.py[cod]

# Caches for tools used in this project (consistent with .flake8 / pyproject.toml)
.mypy_cache/
.pytest_cache/



# ------------------------------------------------------
# Build et Distribution
# ------------------------------------------------------

# Folder containing the final package generated by `uv build` (make build)
dist/
# Intermediate working directory used by the build
build/
# Metadata generated during the build or a development-mode installation
*.egg-info/

# Output generated by default by the programme (export.py)
maze.txt



# ------------------------------------------------------
# configurations locales
# ------------------------------------------------------

# Local VSCode/VSCodium settings
.vscode/

# Windows File Explorer usage in WSL
Thumbs.db
desktop.ini